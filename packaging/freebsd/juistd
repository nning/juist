#!/bin/sh

# PROVIDE: juistd
# REQUIRE: NETWORKING devd
# KEYWORD: shutdown
#
# juistd_enable (bool):   YES runs the default network's juistd, on juist0.
# juistd_instances (str): the other networks' instances, juist1 to juist9.
# juistd_args (str):      more options for juistd, for each of them.
#
# juistd starts as root, keeps a helper as root that plumbs its devices, and
# runs the daemon as the juist user, or another network's instance as its
# own user, juist1 to juist9. "service juistd start juist1" starts one
# instance. "service juistd clear", with none running, removes what one
# that did not stop cleanly, or left refusing the internet, holds of the host.

. /etc/rc.subr

name=juistd
rcvar=juistd_enable
desc="juist mesh VPN daemon"

load_rc_config $name
: ${juistd_enable:="NO"}
: ${juistd_instances:=""}
: ${juistd_args:=""}
: ${juistd_bin:=/usr/local/sbin/juistd}
command=/usr/sbin/daemon
start_precmd=juistd_precmd
extra_commands=clear
clear_cmd=juistd_clear

inst=$2
case $inst in
"")
	pidfile=/var/run/juistd.pid
	logfile=/var/log/juistd.log
	user=juist
	home=/var/db/juist
	rundir=/var/run/juist
	args="--home $home --socket $rundir/juistd.sock --tun juist0"
	;;
juist[1-9])
	name=juistd_$inst
	rcvar=juistd_enable
	juistd_enable=YES
	pidfile=/var/run/juistd.$inst.pid
	logfile=/var/log/juistd.$inst.log
	user=$inst
	home=/var/db/$inst
	rundir=/var/run/$inst
	args="--instance $inst --home $home --socket $rundir/juistd.sock"
	;;
*)
	echo "juistd: no instance $inst: juist1 to juist9" >&2
	exit 64
	;;
esac
case $1 in
*clear) rcvar= ;; # for every juistd, enabled or not
esac
procname=$command
# -H reopens the log on SIGHUP, which newsyslog(8) sends it rotated.
command_args="-f -r -H -P $pidfile -o $logfile $juistd_bin $args $juistd_args"

juistd_precmd()
{
	if ! pw usershow "$user" >/dev/null 2>&1; then
		echo "juistd: there is no $user user, which the package makes" >&2
		return 1
	fi
	# An instance kept its home in the juist user's directory before it had
	# a user of its own: it moves once. That user could have planted links
	# there: a symbolic one is neither moved nor followed as root, and a
	# hard one to another's file, which FreeBSD lets anyone make, keeps its
	# owner, as only what was juist's is given on, once juist is shut out.
	old=/var/db/juist/$inst
	if [ -n "$inst" ] && [ -d "$old" ] && [ ! -L "$old" ] && [ ! -e "$home" ] && [ ! -L "$home" ]; then
		mv "$old" "$home" || return 1
		if [ -L "$home" ] || [ ! -d "$home" ]; then
			# Swapped by juist since it was looked at, for a link, or a
			# hard link to another's file: where it is now, only root
			# changes it, and root's chown and chmod would follow it.
			rm -f "$home"
		else
			chown root:wheel "$home"
			chmod 0700 "$home"
			find "$home" -mindepth 1 -user juist -exec chown -h "$user:$user" {} +
			chown "$user:$user" "$home"
			echo "juistd: $inst's home is $home now"
		fi
	fi
	install -d -o "$user" -g "$user" -m 0700 "$home"
	install -d -o "$user" -g "$user" -m 0755 "$rundir"
	kldload -n if_tuntap
}

# juistd_clear undoes what internal/plumber does to the host: the devices,
# their resolvers, the pf anchors, and forwarding and pf as they were.
juistd_clear()
{
	# The host's own, not a jail's, or a daemon(8) about to start one again.
	running=$(pgrep -j none -x juistd)
	for p in /var/run/juistd.pid /var/run/juistd.juist[1-9].pid; do
		[ -f "$p" ] && pgrep -q -F "$p" && running=yes
	done
	if [ -n "$running" ]; then
		echo "juistd: a juistd runs; stop it first" >&2
		return 1
	fi
	for d in $(ifconfig -l); do
		case $d in
		juist[0-9])
			resolvconf -d "$d" >/dev/null 2>&1
			ifconfig "$d" destroy
			;;
		esac
	done
	# -F all fails at an anchor's tables on FreeBSD 15.1; they go one by one.
	for a in $(pfctl -a juist -s Anchors 2>/dev/null); do
		pfctl -a "$a" -F rules >/dev/null 2>&1
		pfctl -a "$a" -F nat >/dev/null 2>&1
		for t in $(pfctl -a "$a" -s Tables 2>/dev/null); do
			pfctl -a "$a" -t "$t" -T kill >/dev/null 2>&1
		done
	done
	state=/var/run/juistd.host
	if [ -f $state ]; then
		sed -n 's/^was //p' $state | while read -r kv; do
			sysctl "$kv" >/dev/null
		done
		# pf off again where juist turned it on, unless the host loaded its
		# own rules since, or starts pf itself.
		if grep -qx pf-off $state && ! checkyesno pf_enable &&
		    [ "$(pfctl -s rules 2>/dev/null)" = 'anchor "juist/*" all' ] &&
		    [ "$(pfctl -s nat 2>/dev/null | tr -s ' \n' ' ')" = 'nat-anchor "juist/*" all rdr-anchor "juist/*" all ' ]; then
			pfctl -F all >/dev/null 2>&1
			pfctl -d >/dev/null 2>&1
		fi
		rm -f $state
	fi
	echo "juistd: cleared"
}

run_rc_command "$1"
status=$?
if [ -z "$inst" ]; then
	case $1 in
	*start|*stop|*restart|*status)
		for i in $juistd_instances; do
			"$0" "$1" "$i" || status=1
		done
		;;
	esac
fi
exit $status
