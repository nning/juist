# The juist user, a system one below 1000 for juistd's daemon, and
# juist-ingress and juist-serve for the ingress and the terminator; one that
# exists is kept. 829 down is free in the ports tree's UIDs and GIDs.
id=829
for u in juist juist-ingress juist-serve; do
	while pw usershow -u $id >/dev/null 2>&1 || pw groupshow -g $id >/dev/null 2>&1; do
		id=$((id - 1))
	done
	pw groupshow $u >/dev/null 2>&1 || pw groupadd $u -g $id
	home=/nonexistent
	[ $u = juist ] && home=/var/db/juist
	[ $u = juist-serve ] && home=/var/db/juist-serve
	pw usershow $u >/dev/null 2>&1 ||
		pw useradd $u -u $id -g $u -d $home -s /usr/sbin/nologin -c "juist $u"
done
