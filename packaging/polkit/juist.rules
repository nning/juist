// juistd points systemd-resolved at its own resolver and the exit node in
// use on its own device, keeps the domains it answers from DNSSEC validation
// there, and gives the device back: the juist user on juist0, and juistN,
// another network's instance, on juistN alone. Nothing else is allowed, and
// no one is asked. resolved names the device from systemd 256 on, and a
// device named must be the user's own; before, it names none, and the five
// actions are allowed on any link, which juistd, holding CAP_NET_ADMIN,
// could redirect DNS on by other means anyway.
polkit.addRule(function(action, subject) {
	var allowed = [
		"org.freedesktop.resolve1.set-dns-servers",
		"org.freedesktop.resolve1.set-domains",
		"org.freedesktop.resolve1.set-default-route",
		"org.freedesktop.resolve1.set-dnssec-negative-trust-anchors",
		"org.freedesktop.resolve1.revert",
	];
	var user = /^juist([1-9]?)$/.exec(subject.user);
	if (user === null || allowed.indexOf(action.id) < 0) {
		return polkit.Result.NOT_HANDLED;
	}
	var own = "juist" + (user[1] || "0");
	var ifname = action.lookup("interface");
	if (ifname !== undefined && ifname !== null && ifname !== own) {
		return polkit.Result.NOT_HANDLED;
	}
	return polkit.Result.YES;
});
