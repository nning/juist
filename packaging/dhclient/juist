# Sourced by Debian's dhclient-script. Where /etc/resolv.conf is juistd's,
# dhclient writes the host's own beside it, which juistd asks, not juistd's:
# its make_resolv_conf writes to what readlink -f /etc/resolv.conf names.
juist_root=${JUIST_RESOLV_ROOT:-}
if [ "$(command readlink "$juist_root/etc/resolv.conf" 2>/dev/null)" = "$juist_root/run/juist/resolv.conf" ] &&
	[ -e "$juist_root/etc/resolv.pre-juist.conf" ]; then
	readlink() {
		if [ "$#" = 2 ] && [ "$1" = -f ] && [ "$2" = "$juist_root/etc/resolv.conf" ]; then
			command readlink -f "$juist_root/etc/resolv.pre-juist.conf"
		else
			command readlink "$@"
		fi
	}
fi
