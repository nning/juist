#!/bin/sh
# /var/lib/juist is removed on purge only if it is empty: it holds an enrolled
# device's identity, and deleting that behind the operator's back is not a
# package's call. The juist, juist-ingress and juist-serve users are never
# removed, since a UID may own files this package never installed; nor is
# /var/lib/juist-serve, whose ACME account the published names' CAA records
# name.
set -e
if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
fi
if [ "$1" = remove ] || [ "$1" = purge ]; then
	# The service files are gone; firewalld forgets them only on a reload.
	if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
		firewall-cmd --reload >/dev/null 2>&1 || true
	fi
fi
if [ "$1" = remove ] || [ "$1" = purge ]; then
	rm -f /var/lib/polkit-1/localauthority/10-vendor.d/60-juist.pkla
fi
if [ "$1" = purge ]; then
	rm -f /var/lib/juist.removed /var/lib/juist.apparmor
fi
if [ "$1" = purge ] && [ -d /var/lib/juist-serve ]; then
	echo "juist: kept /var/lib/juist-serve, the terminator's ACME account, which CAA records may name" >&2
fi
if [ "$1" = purge ] && [ -d /var/lib/juist ]; then
	rmdir /var/lib/juist 2>/dev/null ||
		echo "juist: kept /var/lib/juist, which still holds this device's keys and log" >&2
fi
exit 0
