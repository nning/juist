#!/bin/sh
# The service is enabled and started on first install: it runs in no network
# and waits, so "sudo juist join CODE" or "juist create" is the next step.
set -e

if [ "$1" = configure ]; then
	if command -v systemd-sysusers >/dev/null 2>&1; then
		systemd-sysusers /usr/lib/sysusers.d/juist.conf
	else
		getent passwd juist >/dev/null ||
			adduser --system --group --home /var/lib/juist --no-create-home juist
		getent passwd juist-ingress >/dev/null ||
			adduser --system --group --home /nonexistent --no-create-home juist-ingress
		getent passwd juist-serve >/dev/null ||
			adduser --system --group --home /var/lib/juist-serve --no-create-home juist-serve
	fi
	# 0700: this directory holds the device's keys. It exists before the
	# service first starts, so the daemon has its home from the start.
	install -d -m 0700 -o juist -g juist /var/lib/juist
	# Traffic on juist0 is let through an active firewalld or ufw on first
	# install only, so an upgrade does not undo a "firewall.sh revoke"; see
	# /usr/lib/juist/firewall.sh for what that admits. A removal's marker
	# is kept where only root writes: /var/lib/juist is the daemon's, and
	# the daemon must not be able to make an upgrade count as a fresh
	# install, or have root act on a file of its choosing.
	fresh=
	if [ -z "$2" ] || [ -e /var/lib/juist.removed ]; then
		fresh=1
		rm -f /var/lib/juist.removed
	fi
	/usr/lib/juist/firewall.sh reload
	if [ -n "$fresh" ]; then
		/usr/lib/juist/firewall.sh allow
	fi

	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		if [ -n "$fresh" ]; then
			systemctl enable --now juistd.service || true
			systemctl enable --now juist-serve.path || true
		else
			# A terminator enabled before juist-serve.path came is started
			# by it.
			if systemctl is-enabled --quiet juist-serve.service 2>/dev/null; then
				systemctl disable --quiet juist-serve.service || true
				systemctl enable --now juist-serve.path || true
			fi
			# An ingress enabled before juist-ingress-ports.path came has
			# the firewall follow its ports by it.
			if systemctl is-enabled --quiet juist-ingress.service 2>/dev/null; then
				systemctl enable --now juist-ingress-ports.path || true
			fi
			# ufw holds a profile's ports as they were when allowed.
			if command -v ufw >/dev/null 2>&1; then
				ufw app update juist-ingress >/dev/null 2>&1 || true
			fi
			# An upgrade restarts the daemons that were running, and only
			# those: the default's and every other network's instance.
			systemctl try-restart juistd.service 'juistd@*.service' juist-ingress.service juist-serve.service || true
		fi
	fi
fi
exit 0
