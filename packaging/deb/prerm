#!/bin/sh
set -e
if [ "$1" = remove ]; then
	if [ -d /run/systemd/system ]; then
		systemctl disable --now juistd.service || true
		# Every other network's instance goes with the package; their state
		# directories stay, as the default's does.
		for i in 1 2 3 4 5 6 7 8 9; do
			systemctl disable --now "juistd@juist$i.service" >/dev/null 2>&1 || true
		done
	fi
	/usr/lib/juist/firewall.sh revoke
	# Remembered for a later reinstall: the package then sits in config-files
	# state, so postinst sees an old version, yet the service is disabled and
	# the firewall rule revoked, as on a first install. See postinst for why
	# it is not kept in /var/lib/juist.
	touch /var/lib/juist.removed
fi
exit 0
