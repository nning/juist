[juist]
title=juist mesh VPN
description=WireGuard and path discovery, the one port the mesh has. Log sync runs inside the tunnel.
ports=41643/udp

[juist-relay]
title=juist member relay
description=The relay (TCP) and the STUN answers members measure it by (UDP), on a relay-capable device.
ports=41645/tcp|41645/udp

[juist-relay-443]
title=juist relay on 443
description=A member relay under a public name, on 443/tcp, where its operator gave it one.
ports=443/tcp

[juist-invite]
title=juist invites
description=Invites taken directly, as a code on the LAN, while "juist invite" runs.
ports=41642/tcp

[juist-ingress]
title=juist ingress
description=The names members publish, over TLS and QUIC, and HTTP redirected to TLS, on the network's ingress.
ports=80,443/tcp|443/udp
