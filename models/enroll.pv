(* Enrollment against an active attacker: the code is a weak secret, the
   welcome stays secret, the two sides agree on the transcript and the
   binding, a request is the guest's own and is admitted only under the keys
   the person compared. Run with -lib enroll; the attacker is in enroll.pvl. *)

free code: bitstring [private].
free link: bitstring [private].
free groupSecret: bitstring [private].

weaksecret code.
query attacker(groupSecret).
query t: bitstring; inj-event(HostAccepts(t)) ==> inj-event(GuestConfirms(t)).
query t: bitstring; inj-event(GuestAccepts(t)) ==> inj-event(HostAccepts(t)).
query b: bitstring; event(GuestBound(b)) ==> event(HostBound(b)).
query b: bitstring, r: bitstring; event(HostReceives(b, r)) ==> event(GuestSends(b, r)).
query p: bitstring, k: bitstring; event(Admitted(p, k)) ==> event(GuestRequests(p, k)).

process
  (!new skG: bitstring; new keysG: bitstring; out(c, (pk(skG), keysG));
    ((!Guest(code, modeCode, skG, keysG)) | (!Guest(link, modeLink, skG, keysG))))
  | (new skAdmin: bitstring; out(c, pk(skAdmin));
    (!Admin(skAdmin)) | (!Host(code, modeCode, groupSecret, pk(skAdmin)))
    | (!Host(link, modeLink, groupSecret, pk(skAdmin))))
