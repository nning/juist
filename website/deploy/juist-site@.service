[Unit]
Description=juist website %i
After=network.target
ConditionPathExists=/var/lib/juist-site/%i/current/server

[Service]
EnvironmentFile=/etc/juist-site/%i
ExecStart=/var/lib/juist-site/%i/current/server -root /var/lib/juist-site/%i/current/site -addr ${ADDR} $FLAGS
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
MemoryMax=128M
Restart=always

[Install]
WantedBy=multi-user.target
