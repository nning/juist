[Unit]
Description=Build juist's website %i from main and serve it
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=juist-build
Group=juist-build
Environment=HOME=/var/lib/juist-build
EnvironmentFile=/etc/juist-site/%i
ExecStart=/usr/local/lib/juist-site/build %i
ExecStartPost=+/usr/local/lib/juist-site/install %i
Nice=19
CPUWeight=idle
IOSchedulingClass=idle
OOMScoreAdjust=500
TimeoutStartSec=1h
